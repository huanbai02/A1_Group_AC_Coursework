# Python cache and bytecode
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Virtual environments and local environments
.venv/
venv/
env/
ENV/
.conda/

# Build, packaging, and coverage artifacts
build/
dist/
*.egg-info/
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter checkpoints
.ipynb_checkpoints/

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment variables and secrets
.env
.env.*
!.env.example

# Generated logs and temporary files
*.log
*.tmp
*.bak

# Coursework generated outputs that should be reproducible
# Keep .gitkeep files so the required empty directory structure is preserved.
data/source/
data/results/predictions/*
!data/results/predictions/.gitkeep
data/results/metrics/*
!data/results/metrics/.gitkeep
data/results/tables/*
!data/results/tables/.gitkeep
data/results/figures/*
!data/results/figures/.gitkeep

# Local validation reports are generated by validate_raw_dataset.py
notes/*
!notes/.gitkeep

.omx/